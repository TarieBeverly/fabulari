MONGODB_URI=mongodb://127.0.0.1:27017/fabulari?replicaSet=fabulari-rs
MONGODB_DATABASE=fabulari
# Set SESSION_SECRET to a long random value when deploying.
# SESSION_SECRET=

# Optional HTTPS, using an already trusted localhost certificate:
# FRONTEND_ORIGIN=https://localhost:4200
# TLS_KEY_PATH=C:/path/to/localhost-key.pem
# TLS_CERT_PATH=C:/path/to/localhost.pem
